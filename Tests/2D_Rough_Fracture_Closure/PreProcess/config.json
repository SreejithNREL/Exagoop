{
  "dimensions": 2,
  "grid": { "xmin": 0.0, "xmax": 1.0, "nx": 50,
            "ymin": 0.0, "ymax": 1.4, "ny": 70 },
  "ppc": [2, 2],

  "bodies": [
    {
      "_comment": "material 0: lower rock block, fixed at y=0.02 (ylo noslip wall is at y=0)",
      "shape": { "type": "rough_block", "xmin": 0.06, "xmax": 0.94,
                 "side": "lower", "y_flat": 0.0, "y_mean": 0.50,
                 "roughness": { "amp": [0.05, 0.03, 0.015], "waves": [2.0, 5.0, 11.0], "phase": [0.0, 1.0, 2.5] } },
      "constitutive_model": { "type": "elastic", "E": 1000.0, "nu": 0.25 },
      "density": 1000.0,
      "initial_velocity": { "type": "uniform", "vx": 0.0, "vy": 0.0 },
      "temperature": { "enabled": false, "type": "uniform", "T": 0.0, "spheat": 1.0, "thermcond": 1.0, "heatsrc": 0.0 }
    },
    {
      "_comment": "material 1: upper rock block; different phases -> unmated surfaces, variable aperture. y_mean gap = 0.13",
      "shape": { "type": "rough_block", "xmin": 0.06, "xmax": 0.94,
                 "side": "upper", "y_flat": 1.00, "y_mean": 0.63,
                 "roughness": { "amp": [0.05, 0.03, 0.015], "waves": [2.0, 5.0, 11.0], "phase": [0.9, 2.6, 0.4] } },
      "constitutive_model": { "type": "elastic", "E": 1000.0, "nu": 0.25 },
      "density": 1000.0,
      "initial_velocity": { "type": "uniform", "vx": 0.0, "vy": 0.0 },
      "temperature": { "enabled": false, "type": "uniform", "T": 0.0, "spheat": 1.0, "thermcond": 1.0, "heatsrc": 0.0 }
    },
    {
      "_comment": "material 2: heavy rigid-like platen, prescribed downward velocity (displacement control). rho_cap/rho_rock = 1e5 so its momentum change is negligible",
      "shape": { "type": "rectangle", "xmin": 0.06, "xmax": 0.94, "ymin": 1.00, "ymax": 1.12 },
      "constitutive_model": { "type": "elastic", "E": 1.0e5, "nu": 0.25 },
      "density": 1.0e8,
      "initial_velocity": { "type": "uniform", "vx": 0.0, "vy": -0.005 },
      "temperature": { "enabled": false, "type": "uniform", "T": 0.0, "spheat": 1.0, "thermcond": 1.0, "heatsrc": 0.0 }
    }
  ],

  "CFL": 0.1,
  "order_scheme": 1,
  "stress_update_scheme": "MUSL",
  "alpha_pic_flip": 0.95,

  "output_tag": "2D_Rough_Fracture_Closure_coarse",
  "input_filename": "Inputs_RoughFractureClosure.inp",
  "output_format": "ascii",
  "materialpoint_filename": "mpm_particles.dat",
  "plot_to_check": false,

  "simulation": {
    "final_time": 16.0,
    "max_steps": 5000000,
    "screen_output_time": 0.1,
    "write_output_time": 0.5,
    "num_redist": 10,
    "fixed_timestep": 0,
    "timestep": 1e-4
  },
  "gravity": [0.0, 0.0, 0.0],
  "density": 1000.0,

  "boundary_conditions": {
    "xlo": { "mom": "slip" },
    "xhi": { "mom": "slip" },
    "ylo": { "mom": "noslip" },
    "yhi": { "mom": "slip" }
  },

  "diagnostics": {
    "print_diagnostics": 1,
    "do_calculate_tke_tse": 1,
    "do_calculate_mwa_velcomp": 0,
    "do_calculate_mwa_velmag": 0,
    "do_calculate_minmaxpos": 1,
    "write_diag_output_time": 0.1
  },

  "build_with_hdf": false,
  "build_system": "gnumake",
  "use_mpi": true,
  "use_cuda": false,
  "use_hip": false,
  "use_omp": false,
  "use_sycl": false,
  "use_eb": false,
  "use_temp": false
}
