{
  "_comment": "JC Plate under gravitational compression. Section 10.3.3, Nguyen et al. 2023.",
  "_units": "mm, ms, kg => stress in GPa, force in kN, density in kg/mm^3",

  "dimensions": 3,

  "grid": {
    "xmin": -5.0,
    "xmax": 15.0,
    "ymin":  0.0,
    "ymax": 15.0,
    "zmin": -0.1,
    "zmax":  0.2,
    "nx": 40,
    "ny": 30,
    "nz":  3
  },

  "ppc": [2, 2, 1],

  "bodies": [
    {
      "shape": {
        "type":  "block",
        "xmin":  0.0,
        "xmax": 10.0,
        "ymin":  0.0,
        "ymax": 10.0,
        "zmin":  0.0,
        "zmax":  0.1
      },
      "constitutive_model": {
        "type":    "johnson_cook",
        "E":        115.0,
        "nu":         0.31,
        "density":    8.94e-6,
        "JC_A":       0.065,
        "JC_B":       0.356,
        "JC_n":       0.37,
        "JC_C":       0.0,
        "JC_m":       0.0,
        "JC_eps_dot_0": 1.0,
        "JC_Tr":      0.0,
        "JC_Tm":   1600.0,
        "JC_chi":     0.9,
        "JC_c0":   3586.0e-3,
        "JC_Salpha":  1.50,
        "JC_Gamma0":  0.0
      },
      "initial_velocity": {
        "type": "uniform",
        "vx": 0.0,
        "vy": 0.0,
        "vz": 0.0
      },
      "temperature": {
        "enabled":   true,
        "type":      "uniform",
        "T":         0.0,
        "spheat":    3.84e-4,
        "thermcond": 3.86e-4,
        "heatsrc":   0.0
      }
    }
  ],

  "physics": {
    "gravity":         [0.0, -5000.0, 0.0],
    "final_time":       0.2,
    "write_output_time": 0.02,
    "screen_output_time": 0.002
  },

  "bc": {
    "ylo": "noslip",
    "yhi": "slip",
    "xlo": "slip",
    "xhi": "slip",
    "zlo": "slip",
    "zhi": "slip"
  },

  "CFL":                  0.3,
  "order_scheme":         3,
  "stress_update_scheme": "MUSL",

  "output_tag":              "JC_Plate_Compression",
  "input_filename":          "Inputs_JCPlate.inp",
  "materialpoint_filename":  "mpm_particles.dat"
}
